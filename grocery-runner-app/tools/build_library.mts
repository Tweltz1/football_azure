// Builds the built-in recipe library (src/lib/libraryData.ts) from the collection pages in
// tools/library_sources.txt, with the app's own parser. Keeps only facts: title, servings, total time,
// ingredients and the page's address. Steps and photos are the site's own work and stay there.
// Run by grocery-runner-store.yml ([stride-library]), which commits the result to the branch.
import { isRoundup, parseCollectionPage, parseRecipePage } from '../src/lib/recipeText';
import { itemKey } from '../src/lib/sharedAisles';

const fs = await import('node:fs' as string);
const SAFARI =
  'Mozilla/5.0 (iPhone; CPU iPhone OS 18_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.5 Mobile/15E148 Safari/604.1';
const sources = String(fs.readFileSync('tools/library_sources.txt', 'utf8'))
  .split('\n')
  .map((l: string) => l.trim())
  .filter((l: string) => l && !l.startsWith('#'))
  .map((l: string) => {
    const [tags, url] = l.split('|').map((p) => p.trim());
    return { tags: tags ? tags.split(',').map((t) => t.trim()).filter(Boolean) : [], url };
  });

const get = async (url: string) => {
  for (let n = 0; n < 3; n++) {
    try {
      const res = await fetch(url, { headers: { 'User-Agent': SAFARI, Accept: 'text/html', 'Accept-Language': 'en-US,en;q=0.9' } });
      if (res.ok) return { html: await res.text(), url: res.url || url };
      console.log(`  HTTP ${res.status} ${url}`);
      if (res.status < 500 && res.status !== 429) return null;
    } catch (e) {
      console.log(`  failed ${url}: ${(e as Error).message}`);
    }
    await new Promise((ok) => setTimeout(ok, 2000 * (n + 1)));
  }
  return null;
};

type Row = { id: string; title: string; servings: string; minutes?: number; url: string; tags: string[]; items: [string, string, 0 | 1, string?][] };
const rows = new Map<string, Row>();
const byTitle = new Map<string, string>();
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);

for (const src of sources) {
  console.log(`\n=== ${src.url}`);
  const page = await get(src.url);
  if (!page) continue;
  const col = parseCollectionPage(page.html, page.url);
  if (!col || !isRoundup(page.html, col)) {
    console.log('  !! not a collection page');
    continue;
  }
  console.log(`  ${col.title}: ${col.recipes.length} links`);
  let kept = 0;
  for (const link of col.recipes) {
    const known = rows.get(link.url);
    if (known) {
      known.tags = [...new Set([...known.tags, ...src.tags])];
      continue;
    }
    await new Promise((ok) => setTimeout(ok, 300));
    const r = await get(link.url);
    if (!r) continue;
    const recipe = parseRecipePage(r.html);
    if (recipe.items.length < 2 || !recipe.title || recipe.title === 'My recipe') {
      console.log(`  -- no recipe: ${link.title} <${link.url}>`);
      continue;
    }
    // The same dish listed on two pages (or two sites) is kept once.
    const t = itemKey(recipe.title);
    const dupe = byTitle.get(t);
    if (dupe) {
      const d = rows.get(dupe)!;
      d.tags = [...new Set([...d.tags, ...src.tags])];
      continue;
    }
    let id = `l-${slug(recipe.title)}`;
    while ([...rows.values()].some((x) => x.id === id)) id += '-2';
    const row: Row = {
      id,
      title: recipe.title,
      servings: recipe.servings,
      url: link.url,
      tags: src.tags,
      items: recipe.items.map((i) => (i.note ? [i.item, i.amount, i.pantry ? 1 : 0, i.note] : [i.item, i.amount, i.pantry ? 1 : 0])),
    };
    if (recipe.minutes && recipe.minutes < 24 * 60) row.minutes = recipe.minutes;
    rows.set(link.url, row);
    byTitle.set(t, link.url);
    kept++;
    console.log(`  + ${recipe.title} (${recipe.items.length} ingredients${row.minutes ? `, ${row.minutes} min` : ''})`);
  }
  console.log(`  kept ${kept} new recipe(s)`);
}

const all = [...rows.values()].sort((a, b) => a.title.localeCompare(b.title));
const out = `// Generated by tools/build_library.mts from tools/library_sources.txt. Do not edit by hand.
// Titles, servings, times and ingredient lists only; each recipe's steps are on its source page (url).
import type { LibraryRow } from './library';

export const LIBRARY_DATA: LibraryRow[] = ${JSON.stringify(all, null, 0).replace(/\},\{"id"/g, '},\n  {"id"')};
`;
fs.writeFileSync('src/lib/libraryData.ts', out);
console.log(`\n${all.length} recipes written to src/lib/libraryData.ts`);
