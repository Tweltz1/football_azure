{
  "expo": {
    "name": "Shop Stride",
    "slug": "grocery-runner",
    "scheme": "groceryrunner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tweltz1.groceryrunner",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tweltz1.groceryrunner"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shop Stride uses your location to show supported grocery stores near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shop Stride reads recipe photos you choose to build your shopping list.",
          "cameraPermission": "Shop Stride uses the camera to photograph recipes for your shopping list.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1F9D55"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
