[{"C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\index.js":"1","C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\App.js":"2","C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\components\\Home.js":"3","C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\components\\CreateLeague.js":"4","C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\components\\LeagueDetails.js":"5","C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\components\\Leagues.js":"6","C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\components\\DraftScreen.js":"7","C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\api.js":"8"},{"size":205,"mtime":1754419878695,"results":"9","hashOfConfig":"10"},{"size":1117,"mtime":1754421590909,"results":"11","hashOfConfig":"10"},{"size":4177,"mtime":1754420914696,"results":"12","hashOfConfig":"10"},{"size":1529,"mtime":1754421058666,"results":"13","hashOfConfig":"10"},{"size":356,"mtime":1754421142048,"results":"14","hashOfConfig":"10"},{"size":1338,"mtime":1754421747362,"results":"15","hashOfConfig":"10"},{"size":3326,"mtime":1754421446221,"results":"16","hashOfConfig":"10"},{"size":429,"mtime":1754411341518,"results":"17","hashOfConfig":"10"},{"filePath":"18","messages":"19","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"20"},"1pid1j3",{"filePath":"21","messages":"22","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"23","messages":"24","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"25","usedDeprecatedRules":"20"},{"filePath":"26","messages":"27","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"20"},{"filePath":"28","messages":"29","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"20"},{"filePath":"30","messages":"31","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"32","messages":"33","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"34","messages":"35","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\index.js",[],["36","37"],"C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\App.js",[],"C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\components\\Home.js",["38"],"import React, { useState, useEffect } from 'react';\r\nimport { useNavigate } from 'react-router-dom';\r\n\r\n// This is a static list of players for now.\r\n// In a real application, you would fetch this data from an API endpoint.\r\nconst initialPlayerList = [\r\n  { name: 'JaMarr Chase', position: 'WR', rank: 1, isFavorite: false },\r\n  { name: 'Bijan Robinson', position: 'RB', rank: 2, isFavorite: false },\r\n  { name: 'CeeDee Lamb', position: 'WR', rank: 3, isFavorite: false },\r\n  { name: 'Justin Jefferson', position: 'WR', rank: 4, isFavorite: false },\r\n  { name: 'Jahmyr Gibbs', position: 'RB', rank: 5, isFavorite: false },\r\n  { name: 'Puka Nacua', position: 'WR', rank: 6, isFavorite: false },\r\n  { name: 'Malik Nabers', position: 'WR', rank: 7, isFavorite: false },\r\n  { name: 'Amon-Ra St. Brown', position: 'WR', rank: 8, isFavorite: false },\r\n  { name: 'Saquon Barkley', position: 'RB', rank: 9, isFavorite: false },\r\n];\r\n\r\nconst Home = ({ userId }) => {\r\n  const [players, setPlayers] = useState(initialPlayerList);\r\n  const [searchTerm, setSearchTerm] = useState('');\r\n  const [sortPosition, setSortPosition] = useState('All Positions');\r\n  const navigate = useNavigate();\r\n\r\n  const filteredPlayers = players\r\n    .filter(player => \r\n      player.name.toLowerCase().includes(searchTerm.toLowerCase())\r\n    )\r\n    .filter(player =>\r\n      sortPosition === 'All Positions' || player.position === sortPosition\r\n    );\r\n\r\n  const toggleFavorite = (playerToToggle) => {\r\n    setPlayers(players.map(player => \r\n      player.name === playerToToggle.name \r\n        ? { ...player, isFavorite: !player.isFavorite }\r\n        : player\r\n    ));\r\n  };\r\n  \r\n  // A hook to fetch data. Uncomment this in a real app.\r\n  // useEffect(() => {\r\n  //   const fetchPlayers = async () => {\r\n  //     const response = await fetch('YOUR_API_ENDPOINT/players');\r\n  //     const data = await response.json();\r\n  //     setPlayers(data);\r\n  //   };\r\n  //   fetchPlayers();\r\n  // }, []);\r\n\r\n  return (\r\n    <div style={{ padding: '20px', textAlign: 'center' }}>\r\n      <h1>Welcome, tyler.weltzin@gmail.com!</h1>\r\n      <p>Get ready for your fantasy football auction draft!</p>\r\n      <p>Your full User ID: {userId}</p>\r\n      <button \r\n        onClick={() => navigate('/leagues')}\r\n        style={{ padding: '10px 20px', fontSize: '18px', cursor: 'pointer' }}\r\n      >\r\n        Go to Leagues\r\n      </button>\r\n\r\n      <div style={{ marginTop: '40px' }}>\r\n        <h2>Global Player Pool (Favorite Players Here!)</h2>\r\n        <div style={{ display: 'flex', justifyContent: 'center', gap: '10px', marginBottom: '20px' }}>\r\n          <div style={{ display: 'flex', alignItems: 'center', gap: '5px' }}>\r\n            <span>Sort by Position:</span>\r\n            <select onChange={(e) => setSortPosition(e.target.value)}>\r\n              <option>All Positions</option>\r\n              <option>WR</option>\r\n              <option>RB</option>\r\n              {/* Add more positions as needed */}\r\n            </select>\r\n          </div>\r\n          <input\r\n            type=\"text\"\r\n            placeholder=\"Search for a player...\"\r\n            value={searchTerm}\r\n            onChange={(e) => setSearchTerm(e.target.value)}\r\n            style={{ padding: '8px' }}\r\n          />\r\n        </div>\r\n        \r\n        <ul style={{ listStyle: 'none', padding: 0, margin: '0 auto', maxWidth: '600px' }}>\r\n          {filteredPlayers.map((player) => (\r\n            <li \r\n              key={player.rank}\r\n              style={{\r\n                display: 'flex', \r\n                justifyContent: 'space-between', \r\n                alignItems: 'center', \r\n                padding: '10px', \r\n                border: '1px solid #ddd', \r\n                marginBottom: '5px'\r\n              }}\r\n            >\r\n              <span>{player.name} ({player.position}) - Rank: {player.rank}</span>\r\n              <span\r\n                style={{ cursor: 'pointer', color: player.isFavorite ? 'gold' : 'grey' }}\r\n                onClick={() => toggleFavorite(player)}\r\n              >\r\n                ★\r\n              </span>\r\n            </li>\r\n          ))}\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Home;","C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\components\\CreateLeague.js",[],"C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\components\\LeagueDetails.js",[],"C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\components\\Leagues.js",[],"C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\components\\DraftScreen.js",[],"C:\\Users\\weltzin\\Documents\\FF\\Fantasy_azure_C#\\FantasyFootballApp\\frontend\\src\\api.js",[],{"ruleId":"39","replacedBy":"40"},{"ruleId":"41","replacedBy":"42"},{"ruleId":"43","severity":1,"message":"44","line":1,"column":27,"nodeType":"45","messageId":"46","endLine":1,"endColumn":36},"no-native-reassign",["47"],"no-negated-in-lhs",["48"],"no-unused-vars","'useEffect' is defined but never used.","Identifier","unusedVar","no-global-assign","no-unsafe-negation"]