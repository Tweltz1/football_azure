# The iPhone app downloads the latest player list from here (it runs from its own origin).
/player-data.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache

# Talk Shops (/shop/) is plain HTML/JS outside the React build, so its files keep the
# same names between deploys. Make browsers check for a new version every time.
/shop/*
  Cache-Control: no-cache
/repair-shop-demo.html
  Cache-Control: no-cache
